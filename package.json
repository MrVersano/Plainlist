{
	"name": "plainlist",
	"version": "1.0.27",
	"description": "Turn your notes into a minimal task manager, with an Inbox, Today and Upcoming lists, and projects that are ordinary notes.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"setup-vault": "node scripts/setup-test-vault.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"chrono-node": "^2.10.2",
		"monkey-around": "^3.0.0",
		"preact": "^11.0.0"
	}
}
